3" value="micro-ROS ↔ ESP32 / sensor" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="148" y="1939" width="200" height="24" as="geometry"/></mxCell><mxCell id="lg4" value="" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#e8590c;strokeWidth=2;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="76" y="1984" as="sourcePoint"/><mxPoint x="136" y="1984" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt4" value="Simulation only" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="148" y="1972" width="200" height="24" as="geometry"/></mxCell><mxCell id="lg5" value="" style="endArrow=blockThin;endFill=1;html=1;rounded=0;strokeColor=#0b7285;strokeWidth=2;dashed=1;dashPattern=6 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="76" y="2017" as="sourcePoint"/><mxPoint x="136" y="2017" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt5" value="Telemetry (read-only → GUI)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="148" y="2005" width="200" height="24" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;Key rules&lt;/b&gt;&lt;br&gt;• &lt;b&gt;One writer per actuator:&lt;/b&gt; only base_controller drives ESP32 #1/#2.&lt;br&gt;• &lt;b&gt;Arbitration:&lt;/b&gt; E-stop › manual › fork / dock › Nav2; 0.5 s timeout → zero.&lt;br&gt;• &lt;b&gt;PID lives on the ESP32&lt;/b&gt;; the Jetson sends m/s setpoints.&lt;br&gt;• &lt;b&gt;TF:&lt;/b&gt; map→odom SLAM · odom→base_footprint EKF · rest robot_state_publisher.&lt;br&gt;• &lt;b&gt;Sim:&lt;/b&gt; /clock from ros_gz_bridge to all nodes; DiffDrive reads /cmd_vel_out.&lt;br&gt;• &lt;b&gt;/rosout&lt;/b&gt; from all nodes → Tab 2.&lt;br&gt;• &lt;b&gt;Hardware e-stop&lt;/b&gt; (power cut) is independent of ROS (D15)." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=12;fontColor=#343a40;" vertex="1" parent="1"><mxGeometry x="860" y="1800" width="1960" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>