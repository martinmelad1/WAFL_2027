<?xml version="1.0"?>
<!-- WAFL 2027 warehouse. GENERATED by scripts/generate_assets.py - edit the generator, not this file.
     World name MUST stay "warehouse" (ros_gz_bridge.yaml uses /world/warehouse/...).
     Robot is NOT in this file: gazebo.launch.py spawns it as model "wafl".
     Frame: x = along the aisle, y = across, robot spawn (see gazebo.launch.py) = (-5.5 0 0). -->
<sdf version="1.9">
  <world name="warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
