<!-- 
  sim_display.launch
  ===================
  Shows the robot URDF in RViz with interactive joint sliders.
  No Gazebo, no hardware needed. Pure model viewer.
  
  Use: roslaunch WAFL2025 sim_display.launch
-->
<launch>

  <!-- Load URDF -->
  <param name="robot_description" textfile="$(find WAFL2025)/urdf/WAFL2025.urdf"/>

  <!-- Joint state publisher with GUI sliders -->
  <node name="joint_state_publisher_gui"
        pkg="joint_state_publisher_gui"
        type="joint_state_publisher_gui"/>

  <!-- Robot state publisher (URDF → TF) -->
  <node name="robot_state_publisher"
        pkg="robot_state_publisher"
        type="robot_state_publisher"/>

  <!-- Static TF: odom → base_link so RViz fixed frame 'odom' resolves correctly -->
  <!-- z=0.559: exact wheel ground clearance from URDF
       base_link→web = -0.351, web→wheel_center = -0.158, wheel_radius = 0.05
       total = 0.351 + 0.158 + 0.05 = 0.559m -->
  <node name="odom_to_base_link"
        pkg="tf"
        type="static_transform_publisher"
        args="0 0 0.559 0 0 0 odom base_link 100"/>

  <!-- RViz with a clean default config -->
  <node name="rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(find WAFL2025)/config/trial.rviz"/>

</launch>
