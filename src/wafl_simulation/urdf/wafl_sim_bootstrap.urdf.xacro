<?xml version="1.0"?>
<!--
  wafl_sim_bootstrap.urdf.xacro - PLACEHOLDER robot so that gazebo.launch.py runs TODAY.
  GENERATED by scripts/generate_assets.py.  Replace it with wafl_description/urdf/wafl.urdf.xacro once that exists
  (it only has to keep the joint/link names listed in wafl_gz_plugins.xacro and include that file).

  ASSUMPTIONS (nothing here is measured): track 0.6 m, wheel radius 0.1 m,
  caster 0.5 m ahead of the axle, forks 0.8 m long at +-0.26375 m (EUR pocket centres),
  lift travel 0.8 m, base mass 55 kg with the battery at the rear (counterweight - without it the
  robot tips forward when it carries a pallet; the validator checks this).
  Frames: base_footprint (floor, rear-axle centre) -> base_link (axle height) -> sensors.
  The LiDAR is at z = 1.3 m (above the mast) so the 2D scan does not hit the robot itself;
  consequence: it does not see pallets/cargo (< 0.75 m) - only racks, cartons, walls.
-->
<robot name="wafl" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find wafl_simulation)/urdf/wafl_gz_plugins.xacro"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial><origin xyz="0.05 0 0.075" rpy="0 0 0"/><mass value="55"/><inertia ixx="1.43229" ixy="0" ixz="0" iyy="3.21979" iyz="0" izz="4.07917"/></inertial>
    <visual name="chassis"><origin xyz="0.25 0 0.075" rpy="0 0 0"/><geometry><box size="0.8 0.5 0.25"/></geometry><material name="chassis_m"><color rgba="0.2 0.35 0.6 1"/></material></visual>
    <collision><origin xyz="0.25 0 0.075" rpy="0 0 0"/><geometry><box size="0.8 0.5 0.25"/></geometry></collision>
    <visual name="mast_l"><origin xyz="0.78 0.38 0.5" rpy="0 0 0"/><geometry><box size="0.04 0.04 1.2"/></geometry><material name="mast_l_m"><color rgba="0.25 0.25 0.28 1"/></material></visual>
    <visual name="mast_r"><origin xyz="0.78 -0.38 0.5" rpy="0 0 0"/><geometry><box size="0.04 0.04 1.2"/></geometry><material name="mast_r_m"><color rgba="0.25 0.25 0.28 1"/></material></visual>
    <visual name="mast_top"><origin xyz="0.78 0 1.08" rpy="0 0 0"/><geometry><box size="0.04 0.8 0.04"/></geometry><material name="mast_top_m"><color rgba="0.25 0.25 0.28 1"/></material></visual>
    <visual name="lidar_pole"><origin xyz="0 0 0.675" rpy="0 0 0"/><geometry><cylinder radius="0.02" length="0.95"/></geometry><material name="lidar_pole_m"><color rgba="0.15 0.15 0.15 1"/></material></visual>
    <visual name="cam_pole"><origin xyz="0.5 0 0.3" rpy="0 0 0"/><geometry><cylinder radius="0.012" length="0.2"/></geometry><material name="cam_pole_m"><color rgba="0.15 0.15 0.15 1"/></material></visual>
  </link>

  <!-- Front-left steering knuckle + drive wheel -->
  <link name="front_left_steer_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.03" length="0.06"/></geometry><material name="steer_l_m"><color rgba="0.2 0.2 0.2 1"/></material></visual>
  </link>
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/><child link="front_left_steer_link"/>
    <origin xyz="0 0.3 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="20" velocity="5"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>

  <link name="front_left_wheel_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.5"/><inertia ixx="0.0042" ixy="0" ixz="0" iyy="0.0075" iyz="0" izz="0.0042"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.1" length="0.06"/></geometry><material name="wheel_l_m"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.1" length="0.06"/></geometry></collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/><child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- Front-right steering knuckle + drive wheel -->
  <link name="front_right_steer_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.03" length="0.06"/></geometry><material name="steer_r_m"><color rgba="0.2 0.2 0.2 1"/></material></visual>
  </link>
  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/><child link="front_right_steer_link"/>
    <origin xyz="0 -0.3 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="20" velocity="5"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>

  <link name="front_right_wheel_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.5"/><inertia ixx="0.0042" ixy="0" ixz="0" iyy="0.0075" iyz="0" izz="0.0042"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.1" length="0.06"/></geometry><material name="wheel_r_m"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.1" length="0.06"/></geometry></collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer_link"/><child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- Rear caster: steering joint (stepper on hardware) + passive rolling wheel -->
  <link name="caster_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><origin xyz="0 0 -0.025" rpy="0 0 0"/><geometry><cylinder radius="0.02" length="0.05"/></geometry><material name="caster_m"><color rgba="0.2 0.2 0.2 1"/></material></visual>
  </link>
  <joint name="caster_joint" type="revolute">
    <parent link="base_link"/><child link="caster_link"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.3963" upper="1.3963" effort="20" velocity="5"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>

  <link name="caster_wheel_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.5"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry><material name="caster_wheel_m"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.05" length="0.04"/></geometry></collision>
  </link>
  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_link"/><child link="caster_wheel_link"/>
    <origin xyz="0.03 0 -0.05" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="fork_carriage_link">
    <inertial><origin xyz="0.4 0 0.1" rpy="0 0 0"/><mass value="6"/><inertia ixx="0.2372" ixy="0" ixz="0" iyy="0.365" iyz="0" izz="0.5122"/></inertial>
    <visual name="plate_l"><origin xyz="0 0.26375 0.15" rpy="0 0 0"/><geometry><box size="0.03 0.12 0.3"/></geometry><material name="plate_l_m"><color rgba="0.9 0.7 0.1 1"/></material></visual>
    <visual name="fork_l"><origin xyz="0.415 0.26375 0.0275" rpy="0 0 0"/><geometry><box size="0.8 0.12 0.035"/></geometry><material name="fork_l_m"><color rgba="0.85 0.65 0.1 1"/></material></visual>
    <visual name="plate_r"><origin xyz="0 -0.26375 0.15" rpy="0 0 0"/><geometry><box size="0.03 0.12 0.3"/></geometry><material name="plate_r_m"><color rgba="0.9 0.7 0.1 1"/></material></visual>
    <visual name="fork_r"><origin xyz="0.415 -0.26375 0.0275" rpy="0 0 0"/><geometry><box size="0.8 0.12 0.035"/></geometry><material name="fork_r_m"><color rgba="0.85 0.65 0.1 1"/></material></visual>
    <visual name="crossbar"><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><box size="0.03 0.62 0.05"/></geometry><material name="crossbar_m"><color rgba="0.9 0.7 0.1 1"/></material></visual>
    <collision><origin xyz="0.415 0.26375 0.0275" rpy="0 0 0"/><geometry><box size="0.8 0.12 0.035"/></geometry></collision>
    <collision><origin xyz="0 0.26375 0.15" rpy="0 0 0"/><geometry><box size="0.03 0.12 0.3"/></geometry></collision>
    <collision><origin xyz="0.415 -0.26375 0.0275" rpy="0 0 0"/><geometry><box size="0.8 0.12 0.035"/></geometry></collision>
    <collision><origin xyz="0 -0.26375 0.15" rpy="0 0 0"/><geometry><box size="0.03 0.12 0.3"/></geometry></collision>
    <collision><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><box size="0.03 0.62 0.05"/></geometry></collision>
  </link>
  <joint name="fork_joint" type="prismatic">
    <parent link="base_link"/><child link="fork_carriage_link"/>
    <origin xyz="0.78 0 -0.1" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="0" upper="0.8" effort="1500" velocity="0.3"/>
    <dynamics damping="20" friction="0"/>
  </joint>

  <link name="laser_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.2"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.04" length="0.05"/></geometry><material name="laser_m"><color rgba="0.8 0.1 0.1 1"/></material></visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_link"/><origin xyz="0 0 1.2" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.2"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.04 0.25 0.05"/></geometry><material name="cam_m"><color rgba="0.1 0.1 0.1 1"/></material></visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/><origin xyz="0.5 0 0.4" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/><origin xyz="0.1 0 0.05" rpy="0 0 0"/>
  </joint>

  <gazebo reference="front_left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="front_right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="caster_wheel_link"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  <gazebo reference="fork_carriage_link"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
</robot>
