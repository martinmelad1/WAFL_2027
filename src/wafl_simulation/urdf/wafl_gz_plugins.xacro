<?xml version="1.0"?>
<!--
  wafl_gz_plugins.xacro - Gazebo Harmonic plugins + sensors for the WAFL robot.
  GENERATED by scripts/generate_assets.py (but meant to be copied/included by the REAL wafl_description URDF).

  Include from the robot xacro with:
      <xacro:include filename="$(find wafl_simulation)/urdf/wafl_gz_plugins.xacro"/>

  The robot URDF MUST provide (names are what config/ros_gz_bridge.yaml relies on):
      joints : left_wheel_joint, right_wheel_joint (continuous, rotate about the axle),
               caster_joint (revolute, +-80 deg), fork_joint (prismatic, up = +)
      links  : laser_link, camera_link (x forward), imu_link
  Gazebo model name MUST be "wafl" (gazebo.launch.py spawns with -name wafl).

  Design rules taken from the README:
       * Odometry comes from OdometryPublisher; there is NO DiffDrive (it cannot model steered wheels).
    * The odometry TF goes to an UNBRIDGED topic: the EKF is the only odom->base_footprint publisher.
    * Caster = joint position controller (radians) on /model/wafl/joint/caster_joint/cmd_pos.
    * Fork   = joint velocity controller on /model/wafl/joint/fork_joint/cmd_vel.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <gazebo>
    <!-- Odometry = ground-truth pose of the model (base_footprint). Its TF goes to an UNBRIDGED topic:
         the EKF is the only odom->base_footprint publisher. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/model/wafl/odometry</odom_topic>
      <tf_topic>/model/wafl/tf_unused_ekf_owns_odom_tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>

    <!-- FRONT STEERING (alpha): both joints listen to the SAME gz topic, so they stay parallel like the chain. -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>leftweb</joint_name>
      <topic>/model/wafl/front_steer/cmd_pos</topic>
      <p_gain>60.0</p_gain><i_gain>1.0</i_gain><d_gain>2.0</d_gain>
      <i_max>10.0</i_max><i_min>-10.0</i_min>
      <cmd_max>40.0</cmd_max><cmd_min>-40.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rightweb</joint_name>
      <topic>/model/wafl/front_steer/cmd_pos</topic>
      <p_gain>60.0</p_gain><i_gain>1.0</i_gain><d_gain>2.0</d_gain>
      <i_max>10.0</i_max><i_min>-10.0</i_min>
      <cmd_max>40.0</cmd_max><cmd_min>-40.0</cmd_min>
    </plugin>

    <!-- REAR STEERING (beta) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>castorjoint</joint_name>
      <topic>/model/wafl/joint/caster_joint/cmd_pos</topic>
      <p_gain>40.0</p_gain><i_gain>0.8</i_gain><d_gain>1.2</d_gain>
      <i_max>8.0</i_max><i_min>-8.0</i_min>
      <cmd_max>30.0</cmd_max><cmd_min>-30.0</cmd_min>
    </plugin>

    <!-- FRONT DRIVE WHEELS: velocity PID acting on torque (a raw velocity set makes the body jerk).
         If gz rejects use_force_commands, delete it and the gain tags: you get plain velocity control. -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>leftwheel</joint_name>
      <topic>/model/wafl/joint/front_left_wheel_joint/cmd_vel</topic>
      <use_force_commands>true</use_force_commands>
      <p_gain>4.0</p_gain><i_gain>1.0</i_gain><d_gain>0.0</d_gain>
      <i_max>5.0</i_max><i_min>-5.0</i_min>
      <cmd_max>8.0</cmd_max><cmd_min>-8.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rightwheel</joint_name>
      <topic>/model/wafl/joint/front_right_wheel_joint/cmd_vel</topic>
      <use_force_commands>true</use_force_commands>
      <p_gain>4.0</p_gain><i_gain>1.0</i_gain><d_gain>0.0</d_gain>
      <i_max>5.0</i_max><i_min>-5.0</i_min>
      <cmd_max>8.0</cmd_max><cmd_min>-8.0</cmd_min>
    </plugin>
    <!-- rear wheel (castorwheel): passive, no plugin -->

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

  <!-- RPLiDAR A2M8-like (ASSUMPTION: 360 deg, 0.5 deg steps, 0.15-12 m, 10 Hz) -->
  <gazebo reference="laser_link">
    <sensor name="rplidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/lidar/scan</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.13287</max_angle>
          </horizontal>
        </scan>
        <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Kinect v1 RGB + registered depth. HFOV 1.09207 rad is derived from the README intrinsics
       (fx = 526.607 px @ 640 px) so ArUco pose estimation in sim matches pallet_pose_node. -->
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera/image</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.09207</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20.0</far></clip>
      </camera>
    </sensor>
    <sensor name="depth_camera" type="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera/depth</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.09207</horizontal_fov>
        <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
        <clip><near>0.5</near><far>4.5</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU (ASSUMPTION: 100 Hz, small gaussian noise; replace with BNO055 numbers once chosen, D19) -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
</robot>
